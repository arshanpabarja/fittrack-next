# Copy values into the EnvironmentFile actually used by the service.
# Django does not automatically load this file. Do not upload it to the public web root.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-private-random-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=lifeboxgym.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lifeboxgym.com
# Only with the private reverse proxy in nginx.conf.example.
DJANGO_TRUST_PROXY_SSL=1
DJANGO_SECURE_HSTS_SECONDS=3600
FITTRACK_DB_PATH=/var/www/database/gym_users.db
SMS_IR_API_KEY=replace-with-a-fresh-private-sms-key
SMS_IR_TEMPLATE_ID=511188
# Preserve the same source and token as the existing gym installation.
FITTRACK_REMOTE_SYNC=1
FITTRACK_SYNC_SOURCE=replace-with-the-existing-gym-source-id
FITTRACK_DESKTOP_API_TOKEN=replace-with-the-existing-private-gym-token
