# Merge into the existing HTTPS virtual host; retain its certificate configuration.
# The HTTP virtual host must redirect to https://lifeboxgym.com$request_uri.
# Reject unknown Host headers in the default virtual host.
# Gunicorn must only listen on 127.0.0.1, never on a public interface.

location /static/ {
    alias /var/www/lifebox/web_portal/staticfiles/;
}

location /assets/ {
    alias /var/www/lifebox/lifebox-landing/assets/;
    add_header Cache-Control "public, max-age=86400";
}

# HTML, authenticated pages and API routes always go through Django.
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_cache off;
    proxy_read_timeout 65s;
    client_max_body_size 10m;
}
